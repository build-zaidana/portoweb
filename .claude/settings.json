{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npm create astro *)",
      "Bash(npx astro *)",
      "Bash(npx prettier *)",
      "Bash(npx playwright *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git init)",
      "mcp__playwright",
      "mcp__context7",
      "WebFetch(domain:docs.astro.build)",
      "WebFetch(domain:tailwindcss.com)",
      "WebFetch(domain:buttondown.com)",
      "WebFetch(domain:docs.netlify.com)",
      "WebFetch(domain:vercel.com)",
      "WebFetch(domain:fontsource.org)",
      "WebFetch(domain:fontshare.com)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm uninstall *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ]
  },
  "enabledMcpjsonServers": [
    "playwright",
    "context7"
  ]
}

---
/** Friendly 404: says what happened in plain words and offers the likely next stops. */
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import LabelStrip from "../components/ui/LabelStrip.astro";
import SketchIcon from "../components/ui/SketchIcon.astro";
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <section class="lost wrap" aria-labelledby="lost-title">
    <div class="copy">
      <LabelStrip text="404" seed={3} />
      <h1 id="lost-title" class="page-title">
        This page isn't here.
      </h1>
      <p class="lead">The link might be old or mistyped. Try one of these:</p>
      <div class="actions">
        <Button variant="primary" size="lg" href="/">
          Back to home
        </Button>
        <Button variant="secondary" size="lg" href="/projects">
          See the projects
        </Button>
      </div>
    </div>
    <div class="art" aria-hidden="true">
      <SketchIcon name="cloud" size={160} />
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    display: grid;
    gap: 3rem;
    align-items: center;
    padding-block: clamp(4rem, 3rem + 6vw, 9rem);
  }
  @media (min-width: 56rem) {
    .lost {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }
  .copy {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }
  .lead {
    max-inline-size: 44ch;
    font-size: var(--text-step-1);
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .art {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    max-inline-size: 22rem;
    border-radius: var(--radius-xl);
    background-color: var(--surface);
    color: var(--ink-soft);
  }
</style>

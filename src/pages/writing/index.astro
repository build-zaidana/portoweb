---
/**
 * Writing index. Grouped by year with the year as a large sticky marker on the left,
 * like the spine of a notebook: dates matter here (PRD G2: publish dates stay visible).
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import SampleBadge from "../../components/ui/SampleBadge.astro";
import Newsletter from "../../components/Newsletter.astro";
import { getWriting } from "../../lib/content";
import { formatDate, isoDate, readingTime } from "../../lib/format";

const posts = await getWriting();
const years = Map.groupBy(posts, (post) => post.data.publishedAt.getUTCFullYear());
---

<BaseLayout
  title="Writing"
  description="Notes on what I learn while building fullstack and AI projects: plain explanations, mistakes, and fixes."
>
  <section class="head wrap" aria-labelledby="writing-title">
    <h1 id="writing-title" class="page-title">
      Writing
    </h1>
    <div class="intro">
      <p class="lead">
        What I learn, written down while it's still fresh. Plain explanations, the mistakes I made, and what
        fixed them.
      </p>
      <a class="link" href="/rss.xml">
        Follow with RSS
      </a>
    </div>
  </section>

  <div class="years wrap">
    {posts.length === 0 && (
      <p class="empty">
        No notes published yet.{" "}
        <a class="link" href="/rss.xml">
          Follow with RSS
        </a>{" "}
        to get the first one.
      </p>
    )}
    {[...years].map(([year, list]) => (
      <section class="year" aria-labelledby={`year-${year}`}>
        <h2 id={`year-${year}`} class="year-label">
          {year}
        </h2>
        <ol class="posts" role="list">
          {list.map((post) => (
            <li>
              <article class="post">
                <p class="post-meta">
                  <time datetime={isoDate(post.data.publishedAt)}>{formatDate(post.data.publishedAt)}</time>
                  <span aria-hidden="true">·</span>
                  <span>{readingTime(post.body)}</span>
                  {post.data.sample && <SampleBadge />}
                </p>
                <h3
                  class="post-title vt-morph"
                  transition:name={`post-title-${post.id}`}
                  transition:animate="initial"
                >
                  <a class="stretched" href={`/writing/${post.id}`}>
                    <span class="title-line">{post.data.title}</span>
                  </a>
                </h3>
                <p class="post-description">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <ul class="tags" role="list" aria-label="Tags">
                    {post.data.tags.map((tag) => (
                      <li>{tag.replaceAll("-", " ")}</li>
                    ))}
                  </ul>
                )}
              </article>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <div class="wrap subscribe">
    <Newsletter />
  </div>
</BaseLayout>

<style>
  .head {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  @media (min-width: 64rem) {
    .head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
    }
  }
  .intro {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  .lead {
    max-inline-size: 46ch;
    font-size: var(--text-step-1);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .year {
    display: grid;
    gap: 1rem;
    padding-block: 2rem;
    border-block-start: 1px solid var(--line);
  }
  @media (min-width: 56rem) {
    .year {
      grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
      gap: 3rem;
    }
    .year-label {
      position: sticky;
      inset-block-start: 7rem;
      align-self: start;
    }
  }
  .year-label {
    font-size: var(--text-step-4);
    line-height: 1;
    color: var(--ink-soft);
    font-variant-numeric: oldstyle-nums;
  }

  .posts {
    display: grid;
  }
  .posts > li + li {
    border-block-start: 1px solid var(--line);
  }
  .post {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding-block: 1.25rem 1.75rem;
  }
  .posts > li:first-child .post {
    padding-block-start: 0;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-soft);
    font-size: var(--text-step--1);
  }
  .post-title {
    max-inline-size: 26ch;
    font-size: var(--text-step-3);
    line-height: var(--text-step-3--line-height);
  }
  .stretched {
    color: inherit;
    text-decoration: none;
  }
  .stretched::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .stretched:focus-visible {
    outline: none;
  }
  .post:has(.stretched:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 6px;
    border-radius: var(--radius-md);
  }
  .title-line {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1.5px no-repeat;
    transition: background-size var(--dur-4) var(--ease-out);
  }
  @media (hover: hover) {
    .post:hover .title-line {
      background-size: 100% 1.5px;
    }
  }
  .post-description {
    max-inline-size: 58ch;
    color: var(--ink-soft);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tags li {
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    background-color: var(--surface);
    font-size: var(--text-step--1);
  }
  .empty {
    padding-block: 3rem;
    color: var(--ink-soft);
  }

  .subscribe {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
  }
</style>

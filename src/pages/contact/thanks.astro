---
/** Where the contact form lands when it is sent without JavaScript (Netlify Forms redirect). */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import LabelStrip from "../../components/ui/LabelStrip.astro";
---

<BaseLayout title="Message sent" description="Your message to Zaidana was sent." noindex>
  <section class="sent wrap" aria-labelledby="sent-title">
    <LabelStrip text="Message sent" seed={5} />
    <h1 id="sent-title" class="page-title">
      Thanks, your message was sent.
    </h1>
    <p class="lead">I'll reply to the email address you gave. While you wait, here's what I'm working on.</p>
    <div class="actions">
      <Button variant="primary" size="lg" href="/projects">
        See the projects
      </Button>
      <Button variant="secondary" size="lg" href="/">
        Back to home
      </Button>
    </div>
  </section>
</BaseLayout>

<style>
  .sent {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
    padding-block: clamp(4rem, 3rem + 6vw, 9rem);
  }
  .lead {
    max-inline-size: 44ch;
    font-size: var(--text-step-1);
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>

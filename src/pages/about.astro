---
/**
 * About. Answers Rian's second question ("is this person a fit?") in one scroll:
 * story + photo → what she's looking for (logistics, CV) → how she thinks → timeline → where next.
 * Facts come only from PRD §1/§4 and src/lib/site.ts (profile). Copy is draft until Phase 4.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import SampleBadge from "../components/ui/SampleBadge.astro";
import SketchIcon from "../components/ui/SketchIcon.astro";
import WhereNext from "../components/WhereNext.astro";
import { getLatestNow, getProjects, getTimeline, getWriting } from "../lib/content";
import { formatMonth, isoDate } from "../lib/format";
import { contactHref, profile } from "../lib/site";

const [timeline, projects, writing, now] = await Promise.all([
  getTimeline(),
  getProjects(),
  getWriting(),
  getLatestNow(),
]);

/** Door hints come from real content when there is some. */
const building = projects.filter((p) => p.data.status === "building").length;
const hints = {
  projects: projects.length > 0 ? `${projects.length} so far, ${building} in progress` : undefined,
  writing: writing[0] ? `Latest: ${writing[0].data.title}` : undefined,
  now: now ? `Updated ${formatMonth(now.data.month)}` : undefined,
  contact: `Remote, ${profile.timezone}`,
};

/** PRD §4 "Diferensiasi": data-based thinking, curiosity, sharing through open discussion. */
const principles = [
  {
    statement: "Look at the evidence before deciding.",
    note: "When I'm unsure, I measure first: a log line, a quick test, a small experiment. Then I choose.",
  },
  {
    statement: "Stay curious about how things work.",
    note: "I take things apart until I can explain them in plain words. If I can't, I haven't understood it yet.",
  },
  {
    statement: "Learn out loud.",
    note: "I share what I learn and ask questions in the open. Discussion teaches me faster than working alone.",
  },
];
---

<BaseLayout
  title="About"
  description="Zaidana is a Software Engineering student in Indonesia learning fullstack development and AI in public, open to remote internships and junior roles."
>
  <!-- ── Intro: story + photo ─────────────────────────────── -->
  <section class="intro wrap" aria-labelledby="about-title">
    <div class="story">
      <h1 id="about-title" class="page-title">
        Learning to build, and writing it down.
      </h1>
      <div class="prose">
        <p>
          I'm Zaidana, a 21-year-old {profile.role} in {profile.country}. I'm learning fullstack development
          and AI, and I care most about software that makes people's work easier, especially in education and
          in how young people use technology.
        </p>
        <p>
          I'm early in my career, so this site shows the work while it's happening: projects with notes on
          what I'd change, short write-ups of what I learn, and a{" "}
          <a class="link" href="/now">
            now page
          </a>{" "}
          that shows what I'm working on this month.
        </p>
      </div>
    </div>

    <figure class="photo">
      <!-- Placeholder until a real photo is added (square frame, not a circle: Gate 0 decision). -->
      <div class="photo-frame" role="img" aria-label="Photo of Zaidana, coming soon">
        <SketchIcon name="cloud" size={56} />
        <span>Photo coming soon</span>
      </div>
      <figcaption>Placeholder</figcaption>
    </figure>
  </section>

  <!-- ── What I'm looking for (Rian's logistics) ──────────── -->
  <section class="looking wrap" aria-labelledby="looking-title">
    <div class="looking-card">
      <h2 id="looking-title" class="section-title">
        What I'm looking for
      </h2>
      <dl class="facts">
        <div>
          <dt>Role</dt>
          <dd>Remote internships or junior roles in fullstack or AI</dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>{profile.country}, working remotely</dd>
        </div>
        <div>
          <dt>Time zone</dt>
          <dd>{profile.timezone}</dd>
        </div>
        <div>
          <dt>CV</dt>
          <dd>
            <a class="link" href={profile.cv.href} download>
              Download CV (PDF{profile.cv.placeholder ? ", placeholder" : ""})
            </a>
          </dd>
        </div>
      </dl>
      <div class="looking-actions">
        <Button variant="primary" size="lg" href={contactHref}>
          Let's talk
        </Button>
        <Button variant="secondary" size="lg" href={profile.github.href} target="_blank" rel="noopener">
          See my GitHub
        </Button>
      </div>
    </div>
  </section>

  <!-- ── How I think: editorial rows, not a card grid ─────── -->
  <section class="principles wrap" aria-labelledby="principles-title">
    <h2 id="principles-title" class="section-title">
      How I think
    </h2>
    <ul class="principle-list" role="list">
      {principles.map((p) => (
        <li class="principle">
          <p class="statement">{p.statement}</p>
          <p class="note">{p.note}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- ── Learning timeline ────────────────────────────────── -->
  {timeline.length > 0 && (
    <section class="timeline wrap" aria-labelledby="timeline-title">
      <div class="timeline-intro">
        <h2 id="timeline-title" class="section-title">
          Learning timeline
        </h2>
        <p>The milestones so far, newest first.</p>
      </div>
      <ol class="milestones" role="list">
        {timeline.map((item) => (
          <li class="milestone">
            <time datetime={isoDate(item.data.date)}>{formatMonth(item.data.date)}</time>
            <div class="milestone-body">
              <p class="milestone-title">
                {item.data.title}
                {item.data.sample && <SampleBadge />}
              </p>
              {item.data.note && <p class="milestone-note">{item.data.note}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  <WhereNext hints={hints} />
</BaseLayout>

<style>
  .page-title {
    font-size: var(--text-step-4);
    line-height: var(--text-step-4--line-height);
    max-inline-size: 14ch;
  }
  .section-title {
    font-size: var(--text-step-3);
    line-height: var(--text-step-3--line-height);
  }

  /* ── Intro ── */
  .intro {
    display: grid;
    gap: 3rem;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(3rem, 2rem + 4vw, 6rem);
  }
  @media (min-width: 64rem) {
    .intro {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: end;
      gap: 4rem;
    }
  }
  .prose {
    display: grid;
    gap: 1.1rem;
    max-inline-size: 60ch;
    margin-block-start: 2rem;
    font-size: var(--text-step-1);
    line-height: 1.55;
  }
  .prose p + p {
    color: var(--ink-soft);
  }

  .photo {
    display: grid;
    gap: 0.6rem;
    max-inline-size: 26rem;
  }
  .photo-frame {
    display: grid;
    aspect-ratio: 4 / 3; /* shorter on phones so the facts below stay close */
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    border-radius: var(--radius-xl);
    background-color: var(--surface);
    background-image: radial-gradient(circle, var(--line-strong) 1px, transparent 1.5px);
    background-size: 14px 14px;
    color: var(--ink-soft);
    rotate: 2deg;
    transition: rotate var(--dur-4) var(--ease-spring);
  }
  @media (hover: hover) {
    .photo:hover .photo-frame {
      rotate: 0deg;
    }
  }
  /* Desktop: taller portrait frame (must come after the base rule to win). */
  @media (min-width: 64rem) {
    .photo-frame {
      aspect-ratio: 4 / 5;
    }
  }
  .photo-frame span {
    font-size: var(--text-step--1);
  }
  figcaption {
    font-size: var(--text-step--1);
    color: var(--ink-soft);
  }

  /* ── Looking for: one warm card, the most important facts for a recruiter ── */
  .looking-card {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    border-radius: var(--radius-xl);
    background-color: var(--tint-sage);
  }
  @media (min-width: 64rem) {
    .looking-card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      column-gap: 4rem;
    }
    .looking-actions {
      grid-column: 2;
    }
  }
  .facts {
    display: grid;
  }
  .facts div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.9rem;
    border-block-end: 1px solid var(--line);
  }
  .facts div:first-child {
    padding-block-start: 0;
  }
  .facts dt {
    color: var(--ink-soft);
    font-size: var(--text-step--1);
    padding-block-start: 0.15rem;
  }
  .facts dd {
    font-weight: 500;
  }
  .looking-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── How I think ── */
  .principles {
    padding-block-start: clamp(5rem, 4rem + 4vw, 8rem);
  }
  .principle-list {
    margin-block-start: 2rem;
  }
  .principle {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.75rem;
    border-block-start: 1px solid var(--line);
  }
  @media (min-width: 64rem) {
    .principle {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      align-items: baseline;
      gap: 3rem;
    }
  }
  .statement {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.25rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .note {
    max-inline-size: 42ch;
    color: var(--ink-soft);
  }

  /* ── Timeline ── */
  .timeline {
    display: grid;
    gap: 2rem;
    padding-block: clamp(5rem, 4rem + 4vw, 8rem);
  }
  @media (min-width: 64rem) {
    .timeline {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
      gap: 3rem;
    }
  }
  .timeline-intro p {
    margin-block-start: 0.75rem;
    color: var(--ink-soft);
  }
  .milestones {
    position: relative;
    display: grid;
    gap: 1.75rem;
    padding-inline-start: 1.5rem;
    border-inline-start: 2px solid var(--line);
  }
  .milestone {
    position: relative;
    display: grid;
    gap: 0.25rem;
  }
  @media (min-width: 48rem) {
    .milestone {
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
  /* Dot on the line for each milestone. */
  .milestone::before {
    content: "";
    position: absolute;
    inset-inline-start: calc(-1.5rem - 6px);
    inset-block-start: 0.45rem;
    inline-size: 10px;
    block-size: 10px;
    border-radius: 999px;
    background-color: var(--paper);
    border: 2px solid var(--sage);
  }
  .milestone time {
    color: var(--ink-soft);
    font-size: var(--text-step--1);
    padding-block-start: 0.2rem;
  }
  .milestone-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
  }
  .milestone-note {
    color: var(--ink-soft);
    font-size: var(--text-step--1);
  }
</style>

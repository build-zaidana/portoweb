---
/**
 * /now (nownownow.com): what Zaidana is focused on this month. Cheap to update and the
 * clearest sign of activity while the project list is short (PRD §5).
 *
 * Written like a short monthly letter: one narrow column, the month as the big headline,
 * plain section names. Deliberately unlike the split headers and label rows of
 * Projects and Writing. Earlier months fold into an archive below.
 */
import { Code } from "astro:components";
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SampleBadge from "../components/ui/SampleBadge.astro";
import { getNowEntries } from "../lib/content";
import { formatMonth, isoDate } from "../lib/format";
import { profile } from "../lib/site";

const entries = await getNowEntries();
const [current, ...earlier] = entries;
const notes = current?.body?.trim() ? await render(current) : undefined;

const sections = [
  { key: "learning", label: "Learning" },
  { key: "building", label: "Building" },
  { key: "reading", label: "Reading" },
] as const;
---

<BaseLayout title="Now" description="What Zaidana is learning, building, and reading this month.">
  <article class="letter wrap">
    <header class="head">
      <h1 class="kicker">Now</h1>
      {current ? (
        <>
          <p class="month">
            <time datetime={isoDate(current.data.month)}>{formatMonth(current.data.month)}</time>
          </p>
          <p class="meta">
            <span>
              {current.data.location ? `Written from ${current.data.location}. ` : ""}I update this{" "}
              <a class="link" href="https://nownownow.com/about" target="_blank" rel="noopener">
                now page<span class="sr-only"> (opens in a new tab)</span>
              </a>{" "}
              about once a month.
            </span>
            {current.data.sample && <SampleBadge />}
          </p>
        </>
      ) : (
        <p class="meta">
          No update yet. See what I'm building on{" "}
          <a class="link" href={profile.github.href} target="_blank" rel="noopener">
            GitHub<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </p>
      )}
    </header>

    {current &&
      sections.map((section) => {
        const items = current.data[section.key];
        if (items.length === 0) return null;
        return (
          <section class="part" aria-labelledby={`now-${section.key}`}>
            <h2 id={`now-${section.key}`} class="part-title">
              {section.label}
            </h2>
            <ul class="items" role="list">
              {items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            {section.key === "learning" && current.data.snippet && (
              <figure class="snippet">
                <Code code={current.data.snippet} lang="ts" theme="css-variables" />
                {current.data.heroNote && <figcaption class="hand">{current.data.heroNote}</figcaption>}
              </figure>
            )}
          </section>
        );
      })}

    {notes && (
      <section class="part" aria-labelledby="now-also">
        <h2 id="now-also" class="part-title">
          Also this month
        </h2>
        <div class="markdown">
          <notes.Content />
        </div>
      </section>
    )}

    <p class="more">
      More:{" "}
      <a class="link" href="/projects">
        what I'm building
      </a>{" "}
      and{" "}
      <a class="link" href="/writing">
        what I've written
      </a>
      .
    </p>
  </article>

  {earlier.length > 0 && (
    <section class="archive wrap" aria-labelledby="archive-title">
      <h2 id="archive-title" class="archive-title">
        Earlier months
      </h2>
      <div class="months">
        {earlier.map((entry) => (
          <details class="month-entry">
            <summary>
              <time datetime={isoDate(entry.data.month)}>{formatMonth(entry.data.month)}</time>
              {entry.data.sample && <SampleBadge />}
            </summary>
            <dl class="month-body">
              {sections.map(
                (section) =>
                  entry.data[section.key].length > 0 && (
                    <div>
                      <dt>{section.label}</dt>
                      <dd>{entry.data[section.key].join("; ")}</dd>
                    </div>
                  ),
              )}
            </dl>
          </details>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* One narrow column, like a letter. */
  .letter,
  .archive {
    max-inline-size: 40rem;
  }
  .letter {
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* the code block scrolls instead of widening the column */
    gap: 2.75rem;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(3rem, 2rem + 4vw, 5rem);
  }
  .head {
    display: grid;
    gap: 0.75rem;
  }
  /* The page name is small; the month is the headline. */
  .kicker {
    font-family: var(--font-sans);
    font-size: var(--text-step-0);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--accent);
  }
  .month {
    font-family: var(--font-display);
    font-size: var(--text-step-5);
    line-height: 0.95;
    letter-spacing: -0.02em;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 0.5rem;
    color: var(--ink-soft);
  }

  .part {
    display: grid;
    gap: 0.9rem;
  }
  .part-title {
    font-size: var(--text-step-2);
    line-height: var(--text-step-2--line-height);
  }
  .items {
    display: grid;
    gap: 0.6rem;
    font-size: var(--text-step-1);
    line-height: 1.5;
  }
  .items li {
    display: flex;
    gap: 0.75rem;
  }
  .items li::before {
    content: "";
    flex: none;
    inline-size: 0.45rem;
    block-size: 0.45rem;
    margin-block-start: 0.65em;
    border-radius: 999px;
    background-color: var(--sage);
  }

  .snippet {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    margin-block-start: 0.5rem;
  }
  .snippet :global(pre) {
    inline-size: 100%;
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    line-height: 1.6;
    overflow-x: auto;
  }
  .hand {
    padding-inline-start: 1.25rem;
    font-family: var(--font-hand);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--accent);
    rotate: -1.5deg;
  }

  .more {
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--line);
    color: var(--ink-soft);
  }

  /* ── Archive ── */
  .archive {
    display: grid;
    gap: 1rem;
    padding-block-end: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .archive-title {
    font-size: var(--text-step-2);
    line-height: var(--text-step-2--line-height);
  }
  .months {
    display: grid;
    gap: 0.5rem;
  }
  .month-entry {
    border-radius: var(--radius-lg);
    background-color: var(--surface);
    /* Height animates open/closed where supported (::details-content + interpolate-size). */
    interpolate-size: allow-keywords;
  }
  .month-entry summary {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-block-size: 3.5rem;
    padding-inline: 1.25rem;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }
  .month-entry summary::-webkit-details-marker {
    display: none;
  }
  /* Chevron turns when the month opens. */
  .month-entry summary::after {
    content: "";
    inline-size: 0.55rem;
    block-size: 0.55rem;
    margin-inline-start: auto;
    border-inline-end: 1.5px solid currentColor;
    border-block-end: 1.5px solid currentColor;
    rotate: 45deg;
    transition: rotate var(--dur-3) var(--ease-spring);
  }
  .month-entry[open] summary::after {
    rotate: 225deg;
  }
  .month-entry::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size var(--dur-3) var(--ease-out),
      content-visibility var(--dur-3) allow-discrete;
  }
  .month-entry[open]::details-content {
    block-size: auto;
  }
  .month-body {
    display: grid;
    gap: 0.75rem;
    padding: 0 1.25rem 1.25rem;
  }
  .month-body dt {
    color: var(--ink-soft);
    font-size: var(--text-step--1);
  }
</style>

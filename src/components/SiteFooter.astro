---
/**
 * Minimal footer for now. Phase 2 turns it into the closing moment:
 * floating cards around "Let's talk" + the oversized ZAIDANA wordmark (cosmos.so).
 */
import { site } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap row">
    <p>
      © {year} {site.name}. Built in public with Astro.
    </p>
    <a class="link" href="/styleguide">
      Styleguide
    </a>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: 7rem;
    padding-block: 2rem 2.5rem;
    border-block-start: 1px solid var(--line);
    color: var(--ink-soft);
    font-size: var(--text-step--1);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }
</style>

---
/**
 * Floating pill navigation (micro.so) with glass (wabi.ai, nav + CTA only).
 * Content scrolling underneath fades out behind a soft gradient (cosmos.so).
 *
 * ≥ 768px: wordmark · centered pill with links · theme toggle + "Let's talk".
 * < 768px: wordmark · theme toggle + Menu button. The menu opens as a panel
 *          that grows out of the pill (disclosure pattern, Escape closes it).
 */
import ThemeToggle from "./ThemeToggle.astro";
import Button from "./ui/Button.astro";
import { contactHref, nav, site } from "../lib/site";

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header" data-site-header>
  <div class="bar wrap">
    <a href="/" class="wordmark" aria-label={`${site.name}, home`}>
      {site.name}
    </a>

    <nav class="pill glass" aria-label="Primary">
      <ul class="links" role="list">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <ThemeToggle />
      <Button variant="glass" href={contactHref} class="cta">
        Let's talk
      </Button>
      <button
        type="button"
        class="menu-button glass"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-button
      >
        <span class="menu-label">Menu</span>
        <span class="menu-icon" aria-hidden="true">
          <i></i>
          <i></i>
        </span>
      </button>
    </div>
  </div>

  <div class="mobile-panel wrap" id="mobile-menu" data-menu-panel>
    <div class="mobile-inner glass">
      <ul role="list">
        {[...nav, { label: "Let's talk", href: contactHref }].map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</header>

<script>
  function setupMenu() {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const button = header?.querySelector<HTMLButtonElement>("[data-menu-button]");
    const panel = header?.querySelector<HTMLElement>("[data-menu-panel]");
    if (!header || !button || !panel) return;

    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      header.toggleAttribute("data-menu-open", open);
    };

    button.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
    header.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && header.hasAttribute("data-menu-open")) {
        setOpen(false);
        button.focus();
      }
    });
    // Close when a link is chosen (ClientRouter keeps the header in memory otherwise).
    panel.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) setOpen(false);
    });
  }

  // The header is re-rendered on every page, so bind again after each navigation.
  document.addEventListener("astro:page-load", setupMenu);
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    padding-block: 0.875rem;
  }
  /* Soft fade: content dissolves under the header instead of being cut. */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0 0 -1.5rem;
    z-index: -1;
    background: linear-gradient(to bottom, var(--paper) 35%, transparent);
    pointer-events: none;
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .wordmark {
    justify-self: start;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
    padding-block: 0.25rem;
  }

  .pill {
    border-radius: 999px;
    padding: 0.3rem;
  }
  .links {
    display: flex;
    gap: 0.125rem;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.5rem;
    padding-inline: 1rem;
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: var(--text-step--1);
    font-weight: 500;
    text-decoration: none;
    transition:
      color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }
  .links a:hover {
    color: var(--ink);
    background-color: var(--line);
  }
  .links a[aria-current="page"] {
    color: var(--paper);
    background-color: var(--ink);
  }

  .actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* ── Mobile menu ─────────────────────────────────────────── */
  .menu-button {
    display: none;
    align-items: center;
    gap: 0.6rem;
    min-block-size: 2.75rem;
    padding-inline: 1rem 0.875rem;
    border-radius: 999px;
    color: var(--ink);
    font-size: var(--text-step--1);
    font-weight: 500;
    transition: transform var(--dur-1) var(--ease-out);
  }
  .menu-button:active {
    transform: scale(0.97);
  }
  .menu-icon {
    position: relative;
    inline-size: 1rem;
    block-size: 0.625rem;
  }
  .menu-icon i {
    position: absolute;
    inset-inline: 0;
    block-size: 1.6px;
    border-radius: 2px;
    background-color: currentColor;
    transition: transform var(--dur-3) var(--ease-out);
  }
  .menu-icon i:first-child {
    inset-block-start: 0;
  }
  .menu-icon i:last-child {
    inset-block-end: 0;
  }
  [data-menu-open] .menu-icon i:first-child {
    transform: translateY(4.2px) rotate(45deg);
  }
  [data-menu-open] .menu-icon i:last-child {
    transform: translateY(-4.2px) rotate(-45deg);
  }

  /* Panel grows from 0 to its natural height (grid-template-rows trick, no JS measuring). */
  .mobile-panel {
    display: none;
    grid-template-rows: 0fr;
    opacity: 0;
    transform: translateY(-0.5rem);
    transition:
      grid-template-rows var(--dur-3) var(--ease-out),
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-3) var(--ease-out),
      visibility 0s linear var(--dur-3);
    visibility: hidden;
  }
  [data-menu-open] .mobile-panel {
    grid-template-rows: 1fr;
    opacity: 1;
    transform: none;
    visibility: visible;
    transition-delay: 0s;
  }
  .mobile-inner {
    overflow: hidden;
    min-block-size: 0;
    margin-block-start: 0.75rem;
    border-radius: var(--radius-lg);
  }
  .mobile-inner ul {
    display: grid;
    padding: 0.5rem;
  }
  .mobile-inner a {
    display: flex;
    align-items: center;
    min-block-size: 3rem;
    padding-inline: 1rem;
    border-radius: var(--radius-md);
    font-family: var(--font-display);
    font-size: 1.625rem;
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--dur-2) var(--ease-out);
  }
  .mobile-inner a:hover,
  .mobile-inner a[aria-current="page"] {
    background-color: var(--line);
  }

  @media (max-width: 47.99rem) {
    .bar {
      grid-template-columns: 1fr auto;
    }
    .pill,
    .actions :global(.cta) {
      display: none;
    }
    .menu-button {
      display: inline-flex;
    }
    .mobile-panel {
      display: grid;
    }
  }
</style>

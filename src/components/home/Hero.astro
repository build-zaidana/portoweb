---
/**
 * Home hero, concept "A + logistics" (chosen at Gate 2).
 * Rian's 5-second read, in order:
 *   1 who (intro line) → 2 focus (headline + phrase) → 3 what she's looking for (logistics + CTA)
 *   → 4 proof (the card stack + a real GitHub link).
 */
import type { HeroCard } from "../../lib/hero";
import { contactHref, profile } from "../../lib/site";
import Button from "../ui/Button.astro";
import Sticker from "../ui/Sticker.astro";
import SketchIcon from "../ui/SketchIcon.astro";
import SkyBackdrop from "./SkyBackdrop.astro";
import HeroStack from "./HeroStack.astro";

interface Props {
  cards: HeroCard[];
}

const { cards } = Astro.props;
const first = cards[0];
const verbText = (verb: HeroCard["verb"]) => (verb === "writing" ? "writing about" : verb);
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="intro">
    <p class="who">
      I'm Zaidana, a {profile.role} in {profile.country}.
    </p>
    <h1 id="hero-title" class="headline">
      Learning to build software that helps people.
    </h1>
    {first && (
      <p class="phrase" data-hero-phrase aria-live="polite">
        Right now I'm <span data-phrase-verb>{verbText(first.verb)}</span>{" "}
        <strong data-phrase-text>{first.phrase}</strong>.
      </p>
    )}

    <div class="actions">
      <Button variant="glass" size="lg" href={contactHref}>
        Let's talk
      </Button>
      <Button variant="secondary" size="lg" href="/projects">
        See what I'm building
      </Button>
    </div>

    <dl class="logistics">
      <div>
        <dt class="sr-only">Looking for</dt>
        <dd>
          <span class="live" aria-hidden="true"></span>Open to remote internships and junior roles
        </dd>
      </div>
      <div>
        <dt class="sr-only">Time zone</dt>
        <dd>
          Based in {profile.country}, working in {profile.timezone}
        </dd>
      </div>
    </dl>

    <a class="proof" href={profile.github.href} target="_blank" rel="noopener">
      <SketchIcon name="build" size={18} />
      <span>
        My code lives on <span class="proof-url">{profile.github.label}</span>
      </span>
    </a>
  </div>

  <div class="visual">
    <div class="sky-frame">
      <SkyBackdrop seed={4} />
      <HeroStack cards={cards} />
    </div>
    <Sticker
      class="hero-sticker"
      text="Open to remote internships"
      label="Open to remote internships"
      icon="spark"
    />
  </div>
</section>

<style>
  .hero {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(3rem, 2rem + 4vw, 6rem);
  }
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      align-items: center;
      gap: 3rem;
      min-block-size: min(46rem, calc(100svh - 5rem));
    }
  }

  /* ── Left: words ─────────────────────────────────────────── */
  .who {
    font-size: var(--text-step-0);
    color: var(--ink-soft);
  }
  /* Big, but capped so the logistics line stays in the first screen (Rian's 5-second read). */
  .headline {
    margin-block-start: 1rem;
    max-inline-size: 12ch;
    font-size: clamp(3.25rem, 1.6rem + 5.4vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
  }
  .phrase {
    margin-block-start: 1.5rem;
    max-inline-size: 30ch;
    font-size: var(--text-step-1);
    line-height: var(--text-step-1--line-height);
    color: var(--ink-soft);
    transition:
      opacity var(--dur-2) var(--ease-out),
      translate var(--dur-2) var(--ease-out);
  }
  .phrase strong {
    color: var(--ink);
    font-weight: 500;
  }
  /* The phrase fades out and back in when the front card changes (HeroStack). */
  .phrase.is-changing {
    opacity: 0;
    translate: 0 -0.35rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2.25rem;
  }

  .logistics {
    display: grid;
    gap: 0.25rem;
    margin-block-start: 1.75rem;
    font-size: var(--text-step--1);
    color: var(--ink-soft);
  }
  .logistics dd {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .logistics div:first-child dd {
    color: var(--ink);
    font-weight: 500;
  }
  /* Small "available" dot (useorigin). Color is a hint; the text says it. */
  .live {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 999px;
    background-color: var(--sage);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--sage) 30%, transparent);
  }
  .logistics div + div dd {
    padding-inline-start: 1rem;
  }

  .proof {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    margin-block-start: 0.75rem;
    color: var(--ink);
    font-size: var(--text-step--1);
    text-decoration: none;
  }
  .proof-url {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent) 40%, transparent);
    text-underline-offset: 0.3em;
    transition:
      text-decoration-color var(--dur-2) var(--ease-out),
      text-underline-offset var(--dur-3) var(--ease-spring);
  }
  .proof:hover .proof-url {
    text-decoration-color: var(--accent);
    text-underline-offset: 0.16em;
  }

  /* ── Right: the sky and the stack ────────────────────────── */
  .visual {
    position: relative;
  }
  .sky-frame {
    position: relative;
    display: grid;
    place-items: center;
    min-block-size: clamp(31rem, 26rem + 14vw, 40rem);
    padding: 3.5rem 1.5rem 1.5rem;
    border-radius: var(--radius-xl);
    isolation: isolate;
  }
  .sky-frame :global(.stack) {
    position: relative;
    z-index: 1;
  }
  .visual :global(.hero-sticker) {
    position: absolute;
    inset-block-start: -1.25rem;
    inset-inline-start: -1rem;
    z-index: 2;
  }
  @media (max-width: 47.99rem) {
    .visual :global(.hero-sticker) {
      inset-inline-start: auto;
      inset-inline-end: -0.25rem;
      inset-block-start: -2rem;
      scale: 0.8;
    }
  }

  /* ── Opening moment, part 1: the words settle in before the cards are dealt. ── */
  @media (prefers-reduced-motion: no-preference) {
    .intro > * {
      animation: hero-rise var(--dur-4) var(--ease-out) both;
    }
    .intro > :nth-child(2) {
      animation-delay: 60ms;
    }
    .intro > :nth-child(3) {
      animation-delay: 120ms;
    }
    .intro > :nth-child(n + 4) {
      animation-delay: 180ms;
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }
</style>

---
/**
 * Writing card (integratedbio reference): the bottom-right corner is cut out
 * ("notched") and the arrow tile sits inside the notch like a puzzle piece.
 *
 * The notch uses CSS `clip-path: shape()`. Browsers without shape() get a
 * normal rounded card with the tile in the corner, which still reads correctly.
 *
 * Tones create rhythm inside one grid: light → deep sage → charcoal.
 */
import type { CollectionEntry } from "astro:content";
import SampleBadge from "../ui/SampleBadge.astro";
import SketchIcon from "../ui/SketchIcon.astro";
import { formatDate, isoDate } from "../../lib/format";

interface Props {
  post: CollectionEntry<"writing">;
  tone?: "light" | "sage" | "ink";
  /** Featured cards show the description. */
  featured?: boolean;
  headingLevel?: 2 | 3;
}

const { post, tone = "light", featured = false, headingLevel = 3 } = Astro.props;
const { title, description, publishedAt, sample } = post.data;
const Heading = `h${headingLevel}` as const;
---

<article class:list={["writing-card", { "is-featured": featured }]} data-tone={tone}>
  <div class="meta">
    <time datetime={isoDate(publishedAt)}>{formatDate(publishedAt)}</time>
    {sample && <SampleBadge class="badge" />}
  </div>

  <Heading class="title">
    <a href={`/writing/${post.id}`} class="stretched">
      <span class="underline">{title}</span>
    </a>
  </Heading>

  {featured && <p class="description">{description}</p>}

  <span class="tile" aria-hidden="true">
    <SketchIcon name="arrow" size={22} />
  </span>
</article>

<style>
  .writing-card {
    /* Notch geometry: tile size + gap around it. */
    --tile: 3.25rem;
    --notch: calc(var(--tile) + 0.5rem);
    --r: var(--radius-lg);
    --nr: 0.875rem; /* notch corner radius */

    --card-bg: var(--surface-raised);
    --card-fg: var(--ink);
    --card-soft: var(--ink-soft);
    --tile-bg: var(--sky);

    position: relative;
    isolation: isolate; /* keeps the ::before surface (z-index -1) inside the card */
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    min-block-size: 15rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    padding-block-end: calc(var(--notch) + 0.5rem);
    padding-inline-end: calc(var(--notch) * 0.5);
  }
  .writing-card[data-tone="sage"] {
    --card-bg: var(--deep-sage);
    --card-fg: var(--on-deep);
    --card-soft: color-mix(in oklab, var(--on-deep) 78%, var(--deep-sage));
    --tile-bg: var(--tint-sage);
  }
  .writing-card[data-tone="ink"] {
    --card-bg: var(--deep-ink);
    --card-fg: var(--on-deep);
    --card-soft: color-mix(in oklab, var(--on-deep) 72%, var(--deep-ink));
    --tile-bg: var(--sage);
  }
  .writing-card.is-featured {
    min-block-size: 20rem;
  }

  /* The card surface is a pseudo-element so the clip never cuts the focus ring. */
  .writing-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: var(--r);
    background-color: var(--card-bg);
  }
  @supports (clip-path: shape(from 0 0, line to 1px 1px)) {
    .writing-card::before {
      border-radius: 0;
      clip-path: shape(
        from var(--r) 0,
        hline to calc(100% - var(--r)),
        arc to 100% var(--r) of var(--r) cw,
        vline to calc(100% - var(--notch) - var(--nr)),
        arc to calc(100% - var(--nr)) calc(100% - var(--notch)) of var(--nr) cw,
        hline to calc(100% - var(--notch) + var(--nr)),
        arc to calc(100% - var(--notch)) calc(100% - var(--notch) + var(--nr)) of var(--nr) ccw,
        vline to calc(100% - var(--nr)),
        arc to calc(100% - var(--notch) - var(--nr)) 100% of var(--nr) cw,
        hline to var(--r),
        arc to 0 calc(100% - var(--r)) of var(--r) cw,
        vline to var(--r),
        arc to var(--r) 0 of var(--r) cw,
        close
      );
    }
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-step--1);
    color: var(--card-soft);
  }
  .writing-card:not([data-tone="light"]) .badge {
    color: var(--card-soft);
    border-color: color-mix(in oklab, var(--on-deep) 40%, transparent);
  }

  .title {
    font-size: var(--text-step-2);
    line-height: var(--text-step-2--line-height);
    color: var(--card-fg);
  }
  .is-featured .title {
    font-size: var(--text-step-3);
    line-height: var(--text-step-3--line-height);
    max-inline-size: 18ch;
  }

  .description {
    max-inline-size: 44ch;
    color: var(--card-soft);
  }

  .stretched {
    color: inherit;
    text-decoration: none;
  }
  .stretched::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: var(--r);
  }
  .stretched:focus-visible {
    outline: none;
  }
  .writing-card:has(.stretched:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
    border-radius: var(--r);
  }

  /* Hover underline grows from the left, line by line (measured: 300ms on integratedbio). */
  .underline {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size var(--dur-3) var(--ease-out);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .writing-card:hover .underline {
    background-size: 100% 1px;
  }

  .tile {
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: 0;
    display: grid;
    place-items: center;
    inline-size: var(--tile);
    block-size: var(--tile);
    border-radius: var(--radius-md);
    background-color: var(--tile-bg);
    color: var(--on-fill);
    transition:
      transform var(--dur-4) var(--ease-soft),
      background-color var(--dur-3) var(--ease-soft);
  }
  .tile :global(svg) {
    transition: transform var(--dur-4) var(--ease-soft);
  }
  /* Hover: the tile settles into the notch and the arrow nudges forward. */
  .writing-card:hover .tile {
    transform: scale(0.9);
  }
  .writing-card:hover .tile :global(svg) {
    transform: translateX(3px);
  }
</style>

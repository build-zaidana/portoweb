---
/**
 * Calm card (letters.app reference): one grey step above the page, no border,
 * no shadow, large radius. Hierarchy comes from tone only.
 * Used on /now and /about ("What I'm building", "What I'm learning").
 *
 * Slots:
 *   label  → small chip at the top (icon + name)
 *   (default) → title + body
 *   art    → optional mini-UI illustration, centered
 *   action → optional pill link at the bottom
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const hasArt = Astro.slots.has("art");
const hasAction = Astro.slots.has("action");
---

<section class:list={["calm-card", className]}>
  {Astro.slots.has("label") && (
    <span class="label">
      <slot name="label" />
    </span>
  )}
  <div class="body">
    <slot />
  </div>
  {hasArt && (
    <div class="art">
      <slot name="art" />
    </div>
  )}
  {hasAction && (
    <div class="action">
      <slot name="action" />
    </div>
  )}
</section>

<style>
  .calm-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    border-radius: var(--radius-xl);
    background-color: var(--surface);
  }
  .label {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem 0.3rem 0.5rem;
    border-radius: 999px;
    background-color: var(--surface-raised);
    font-size: var(--text-step--1);
    font-weight: 500;
  }
  .body :global(h2),
  .body :global(h3),
  .body :global(h4) {
    font-family: var(--font-sans);
    font-size: var(--text-step-1);
    font-weight: 500;
    letter-spacing: -0.005em;
    line-height: 1.3;
    max-inline-size: 26ch;
  }
  .body :global(p) {
    margin-block-start: 0.5rem;
    color: var(--ink-soft);
    max-inline-size: 48ch;
  }
  .art {
    display: grid;
    place-items: center;
    padding-block: 1.5rem;
  }
  .action {
    margin-block-start: auto;
  }
</style>

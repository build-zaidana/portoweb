---
/**
 * Project card (craft.do reference): pastel surface per project + a tilted
 * mini-UI illustration that bleeds off the bottom edge.
 * The whole card is clickable through one real link (the title), so screen
 * readers hear a single, meaningful link instead of a wrapped block.
 */
import type { CollectionEntry } from "astro:content";
import StatusChip from "../ui/StatusChip.astro";
import SampleBadge from "../ui/SampleBadge.astro";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 3 } = Astro.props;
const { title, summary, status, stack, tint, sample } = project.data;
const Heading = `h${headingLevel}` as const;
---

<article class="project-card" data-tint={tint}>
  <div class="meta">
    <StatusChip status={status} />
    {sample && <SampleBadge />}
  </div>

  <Heading class="title">
    <a href={`/projects/${project.id}`} class="stretched">
      {title}
    </a>
  </Heading>
  <p class="summary">{summary}</p>
  <p class="stack">
    <span class="sr-only">Built with </span>
    {stack.join(", ")}
  </p>

  <!-- Placeholder illustration: abstract "window" panels. Real projects swap in a cropped screenshot or sketch. -->
  <div class="art" aria-hidden="true">
    <div class="panel panel--back">
      <span class="bar w-60"></span>
      <span class="bar w-40"></span>
    </div>
    <div class="panel panel--front">
      <span class="dots">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span class="bar w-80"></span>
      <span class="bar w-50"></span>
      <span class="block"></span>
    </div>
  </div>
</article>

<style>
  .project-card {
    --card-tint: var(--tint-sage);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-block-size: 27rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    padding-block-end: 0;
    border-radius: var(--radius-xl);
    background-color: var(--card-tint);
    overflow: hidden;
  }
  .project-card[data-tint="sky"] {
    --card-tint: var(--tint-sky);
  }
  .project-card[data-tint="tan"] {
    --card-tint: var(--tint-tan);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .title {
    margin-block-start: 0.5rem;
    font-size: var(--text-step-2);
    line-height: var(--text-step-2--line-height);
  }

  /* Stretched link: the title's ::after covers the whole card. */
  .stretched {
    color: inherit;
    text-decoration: none;
  }
  .stretched::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .stretched:focus-visible {
    outline: none;
  }
  .project-card:has(.stretched:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  .summary {
    max-inline-size: 36ch;
    color: var(--ink-soft);
  }
  .stack {
    font-size: var(--text-step--1);
    color: var(--ink-soft);
  }

  /* ── Illustration ─────────────────────────────────────────── */
  .art {
    position: relative;
    flex: 1;
    min-block-size: 9.5rem;
    margin-block-start: 1rem;
  }
  .panel {
    position: absolute;
    inset-inline-start: 12%;
    inline-size: 76%;
    block-size: 11rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1rem;
    border-radius: var(--radius-md);
    background-color: var(--surface-raised);
    box-shadow: var(--shadow-lift);
    border: 1px solid var(--line);
    transition: transform var(--dur-3) var(--ease-out);
  }
  .panel--back {
    inset-block-start: 1.25rem;
    inset-inline-start: 30%;
    inline-size: 62%;
    opacity: 0.7;
    transform: rotate(5deg);
  }
  .panel--front {
    inset-block-start: 2.25rem;
    transform: rotate(-3deg);
  }
  .dots {
    display: flex;
    gap: 0.3rem;
  }
  .dots i {
    inline-size: 0.45rem;
    block-size: 0.45rem;
    border-radius: 999px;
    background-color: var(--line-strong);
  }
  .bar {
    display: block;
    block-size: 0.5rem;
    border-radius: 999px;
    background-color: var(--line-strong);
  }
  .w-40 {
    inline-size: 40%;
  }
  .w-50 {
    inline-size: 50%;
  }
  .w-60 {
    inline-size: 60%;
  }
  .w-80 {
    inline-size: 80%;
  }
  .block {
    flex: 1;
    border-radius: var(--radius-sm);
    background-color: var(--card-tint);
  }

  /* Hover (user-triggered): the panels lift and straighten a little. */
  .project-card:hover .panel--front {
    transform: translateY(-0.5rem) rotate(-1.5deg);
  }
  .project-card:hover .panel--back {
    transform: translateY(-0.25rem) rotate(7deg);
  }
</style>

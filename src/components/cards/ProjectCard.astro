---
/**
 * Project card (craft.do reference): pastel surface per project + a tilted
 * mini-UI illustration that bleeds off the bottom edge.
 * The whole card is clickable through one real link (the title), so screen
 * readers hear a single, meaningful link instead of a wrapped block.
 */
import type { CollectionEntry } from "astro:content";
import StatusChip from "../ui/StatusChip.astro";
import SampleBadge from "../ui/SampleBadge.astro";
import ProjectArt from "./ProjectArt.astro";

interface Props {
  project: CollectionEntry<"projects">;
  headingLevel?: 2 | 3;
}

const { project, headingLevel = 3 } = Astro.props;
const { title, summary, status, stack, tint, art, sample } = project.data;
const Heading = `h${headingLevel}` as const;
---

<article class="project-card" data-tint={tint}>
  <div class="meta">
    <StatusChip status={status} />
    {sample && <SampleBadge />}
  </div>

  <Heading class="title">
    <a href={`/projects/${project.id}`} class="stretched">
      {title}
    </a>
  </Heading>
  <p class="summary">{summary}</p>
  <p class="stack">
    <span class="sr-only">Built with </span>
    {stack.join(", ")}
  </p>

  <ProjectArt variant={art} />
</article>

<style>
  .project-card {
    --card-tint: var(--tint-sage);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-block-size: 27rem;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    padding-block-end: 0;
    border-radius: var(--radius-xl);
    background-color: var(--card-tint);
    overflow: hidden;
    transition:
      transform var(--dur-4) var(--ease-spring),
      box-shadow var(--dur-3) var(--ease-out);
  }
  /* Hover (pointer devices only): the card lifts on a spring and casts a warm shadow;
     the illustration inside moves a beat later (see ProjectArt). */
  @media (hover: hover) {
    .project-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-lift);
    }
  }
  .project-card:active {
    transform: translateY(-2px) scale(0.99);
    transition-duration: var(--dur-1);
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card:hover,
    .project-card:active {
      transform: none;
    }
  }
  .project-card[data-tint="sky"] {
    --card-tint: var(--tint-sky);
  }
  .project-card[data-tint="tan"] {
    --card-tint: var(--tint-tan);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .title {
    margin-block-start: 0.5rem;
    font-size: var(--text-step-2);
    line-height: var(--text-step-2--line-height);
  }

  /* Stretched link: the title's ::after covers the whole card. */
  .stretched {
    color: inherit;
    text-decoration: none;
  }
  .stretched::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .stretched:focus-visible {
    outline: none;
  }
  .project-card:has(.stretched:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }

  .summary {
    max-inline-size: 36ch;
    color: var(--ink-soft);
  }
  .stack {
    font-size: var(--text-step--1);
    color: var(--ink-soft);
  }
</style>

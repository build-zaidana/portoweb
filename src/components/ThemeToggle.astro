---
/**
 * Light/dark switch. The choice is stored in localStorage and applied by ThemeScript.
 * Feedback: the page crossfades (View Transition API) and the sketch icon rotates
 * between sun and moon. Both are skipped under prefers-reduced-motion.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button
  type="button"
  class:list={["theme-toggle", className]}
  data-theme-toggle
  aria-label="Switch color theme"
>
  <svg class="icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false" filter="url(#sketch-rough)">
    <!-- Sun: hand-drawn circle + uneven rays -->
    <g class="sun">
      <path d="M16.2 10.6c3 .1 5.4 2.6 5.3 5.6-.1 3-2.7 5.3-5.6 5.2-3-.1-5.3-2.6-5.2-5.6.1-2.9 2.5-5.3 5.5-5.2z" />
      <path d="M16 3.6v3M16.1 25.5v2.9M3.7 16.2h2.9M25.4 15.9h3M7.2 7.4l2 2.1M22.9 22.7l2 2M7.4 24.8l2-2M22.8 9.3l2.1-2" />
    </g>
    <!-- Moon: one crescent stroke, slightly wobbly on purpose -->
    <path
      class="moon"
      d="M21.6 21.9c-4.8 1.6-10-1-11.5-5.8-1.3-4 .5-8.2 4-10.2-.6 3.3.5 6.9 3.3 9.1 2.3 1.8 5.3 2.5 8.1 1.9-.8 2.3-2.1 4.1-3.9 5z"
    />
  </svg>
</button>

<script>
  type Theme = "light" | "dark";

  const current = (): Theme => (document.documentElement.dataset.theme === "dark" ? "dark" : "light");

  const label = (theme: Theme) => (theme === "dark" ? "Switch to light theme" : "Switch to dark theme");

  function syncLabels() {
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
      button.setAttribute("aria-label", label(current()));
    }
  }

  function setTheme(next: Theme) {
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {
      // Storage blocked: the switch still works for this page view.
    }
    syncLabels();
  }

  // One delegated listener survives ClientRouter page swaps (module scripts run once).
  document.addEventListener("click", (event) => {
    const button = (event.target as Element | null)?.closest("[data-theme-toggle]");
    if (!button) return;
    const next: Theme = current() === "dark" ? "light" : "dark";
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!document.startViewTransition || reduceMotion) {
      setTheme(next);
      return;
    }
    document.startViewTransition(() => setTheme(next));
  });

  document.addEventListener("astro:page-load", syncLabels);
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem; /* 44px touch target */
    block-size: 2.75rem;
    border-radius: 999px;
    color: var(--ink);
    transition:
      background-color var(--dur-2) var(--ease-out),
      transform var(--dur-1) var(--ease-out);
  }
  .theme-toggle:hover {
    background-color: var(--line);
  }
  .theme-toggle:active {
    transform: scale(0.94);
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle:active {
      transform: none;
    }
  }

  .icon {
    inline-size: 1.375rem;
    block-size: 1.375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }

  .sun,
  .moon {
    transform-origin: 16px 16px;
    transition:
      transform var(--dur-4) var(--ease-out),
      opacity var(--dur-2) var(--ease-out);
  }

  /* Light theme shows the moon (the action), dark theme shows the sun. */
  .sun {
    opacity: 0;
    transform: rotate(-60deg) scale(0.6);
  }
  :global([data-theme="dark"]) .sun {
    opacity: 1;
    transform: none;
  }
  :global([data-theme="dark"]) .moon {
    opacity: 0;
    transform: rotate(60deg) scale(0.6);
  }
</style>

---
/**
 * Hand-drawn icon set (daylight reference). PLACEHOLDERS until Zaidana draws the final set.
 * The pen feel comes from two offset stroke passes + the shared #sketch-rough SVG filter
 * (defined once in SketchFilter.astro, rendered by BaseLayout).
 * To replace one: draw it on a 32×32 artboard (Excalidraw / tablet), export SVG,
 * and paste its <path> `d` values into `icons` below. Keep stroke-only paths so
 * color, width and round caps stay consistent across the set.
 */
const icons = {
  arrow: ["M7.4 16.3c5.8-.4 11.6-.2 17.2.2", "M18.6 9.6c2.2 2.1 4.3 4.3 6.1 6.8-2 2.3-4 4.5-6.3 6.4"],
  build: [
    "M6.7 25.6l11-11.3",
    "M17.4 14.6c-1.5-3.2-.4-7 2.6-8.8 1.6-.9 3.4-1.1 5.1-.6l-3.4 3.5.6 3.2 3.3.7 3.4-3.5c.6 3.4-1.4 6.8-4.7 7.9-2.3.8-4.8.2-6.5-1.4",
    "M5.2 27.1c-.8-.9-.7-2.1.2-2.9",
  ],
  spark: [
    "M16.1 4.4c.7 5.8 3.8 9.4 11.3 11.6-7.3 2-10.6 5.4-11.4 11.7-.9-6.2-4.1-9.6-11.4-11.5 7.2-2.2 10.6-5.9 11.5-11.8z",
    "M25.6 4.8v4.4M23.4 7h4.4",
  ],
  book: [
    "M16 9.1c-3.1-2.3-7.2-2.8-10.8-1.6v17.1c3.6-1.2 7.7-.6 10.8 1.7",
    "M16 9.1c3.2-2.4 7.3-2.9 10.9-1.7-.1 5.7 0 11.4-.1 17.1-3.6-1.2-7.7-.6-10.8 1.8",
    "M16 9.2v17",
  ],
  cloud: [
    "M9.6 23.9c-3 .1-5.3-2.1-5.3-4.9 0-2.6 2-4.7 4.6-4.9.5-3.8 3.8-6.6 7.7-6.4 3.3.2 6 2.5 6.8 5.6 3.1-.1 5.4 2.3 5.3 5.2-.1 2.9-2.5 5.3-5.5 5.2-4.5.1-9.1.2-13.6.2z",
  ],
} as const;

export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  /** Accessible name. Omit for decorative icons next to visible text. */
  label?: string;
  size?: number;
  class?: string;
}

const { name, label, size = 24, class: className } = Astro.props;
---

<svg
  class:list={["sketch-icon", className]}
  viewBox="0 0 32 32"
  width={size}
  height={size}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <g filter="url(#sketch-rough)">
    {icons[name].map((d) => (
      <>
        {/* Two passes of the same stroke, slightly offset: reads like pen on paper. */}
        <path d={d} class="pass-1" />
        <path d={d} class="pass-2" />
      </>
    ))}
  </g>
</svg>

<style>
  .sketch-icon {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }
  .pass-1 {
    stroke-width: 1.8;
  }
  /* Second, thinner pass drawn slightly off the first one, like a quick re-trace with a pen. */
  .pass-2 {
    stroke-width: 1;
    opacity: 0.6;
    transform: translate(0.8px, -0.6px) rotate(1.4deg);
    transform-origin: center;
  }
</style>

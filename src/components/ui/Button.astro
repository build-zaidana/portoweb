---
/**
 * Pill button, rendered as <a> when `href` is given, otherwise <button>.
 *
 * Variants (one clear hierarchy per screen):
 * - primary:   solid ink. The single main action.
 * - secondary: outline. Everything else.
 * - glass:     frosted pill with a moving sheen. ONLY for the hero CTA and the nav CTA.
 */
import type { HTMLAttributes } from "astro/types";

type Variant = "primary" | "secondary" | "glass";
type Size = "md" | "lg";

type Props = {
  variant?: Variant;
  size?: Size;
  href?: string;
  class?: string;
} & Omit<HTMLAttributes<"a"> & HTMLAttributes<"button">, "class">;

const { variant = "primary", size = "md", href, class: className, ...rest } = Astro.props;
const Tag = href ? "a" : "button";
const typeAttr = href ? {} : { type: (rest as HTMLAttributes<"button">).type ?? "button" };
---

<Tag
  href={href}
  class:list={["btn", `btn--${variant}`, `btn--${size}`, { glass: variant === "glass" }, className]}
  {...typeAttr}
  {...rest}
>
  <span class="btn__label">
    <slot />
  </span>
</Tag>

<style>
  /*
   * Motion model (same for every variant, only the surface differs):
   *   hover  → lifts 2px on a spring, color/shadow ease in (only on devices that can hover)
   *   press  → drops back and shrinks to 97% quickly (150ms)
   *   release→ springs back (--ease-spring, 400ms)
   * Reduced motion: no movement; colors still change instantly.
   */
  .btn {
    --btn-h: 2.75rem; /* 44px minimum touch target */
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-block-size: var(--btn-h);
    padding-inline: 1.25rem;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: var(--text-step--1);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    overflow: hidden; /* clips the secondary fill and the glass sheen to the pill */
    transition:
      transform var(--dur-4) var(--ease-spring),
      background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }
  .btn--lg {
    --btn-h: 3.25rem;
    padding-inline: 1.625rem;
    font-size: var(--text-step-0);
  }
  .btn__label {
    position: relative; /* above the ::before fill */
  }

  @media (hover: hover) {
    .btn:hover {
      transform: translateY(-2px);
    }
  }
  .btn:active {
    transform: translateY(0) scale(0.97);
    transition-duration: var(--dur-1);
  }

  /* ── Primary: solid ink, gains a soft shadow as it lifts ───────── */
  .btn--primary {
    background-color: var(--ink);
    color: var(--paper);
  }
  .btn--primary:hover {
    background-color: color-mix(in oklab, var(--ink) 88%, var(--sage));
    box-shadow: var(--shadow-lift);
  }

  /* ── Secondary: outline that fills with ink from the bottom ────── */
  .btn--secondary {
    border: 1px solid var(--line-strong);
    color: var(--ink);
  }
  .btn--secondary::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--ink);
    clip-path: inset(100% 0 0 0);
    transition: clip-path var(--dur-3) var(--ease-out);
  }
  .btn--secondary:hover {
    border-color: var(--ink);
    color: var(--paper);
  }
  .btn--secondary:hover::before {
    clip-path: inset(0 0 0 0);
  }

  /* ── Glass (wabi.ai): frosted surface from global .glass + a light sweep ── */
  .btn--glass {
    color: var(--ink);
  }
  .btn--glass::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(105deg, transparent 30%, var(--glass-shine) 48%, transparent 66%);
    background-size: 250% 100%;
    background-position: 130% 0;
    opacity: 0;
    transition:
      background-position var(--dur-4) var(--ease-in-out),
      opacity var(--dur-2) var(--ease-out);
  }
  .btn--glass:hover::after {
    background-position: -30% 0;
    opacity: 1;
  }
  .btn--glass:hover {
    box-shadow:
      inset 0 1px 0 var(--glass-shine),
      0 1px 1px var(--shadow-tint),
      0 14px 32px -12px var(--shadow-tint);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover,
    .btn:active {
      transform: none;
    }
    .btn--glass::after {
      display: none;
    }
  }
</style>

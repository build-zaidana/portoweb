---
/** Quiet "back to the list" link above detail pages. The arrow nudges back on hover. */
import SketchIcon from "./SketchIcon.astro";

interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a class="back" href={href}>
  <span class="icon" aria-hidden="true">
    <SketchIcon name="arrow" size={18} />
  </span>
  <slot />
</a>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    justify-self: start;
    min-block-size: 2.75rem;
    margin-block-end: 0.5rem;
    color: var(--ink-soft);
    font-size: var(--text-step--1);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--dur-2) var(--ease-out);
  }
  .icon {
    display: inline-flex;
    rotate: 180deg;
    transition: translate var(--dur-3) var(--ease-spring);
  }
  .back:hover {
    color: var(--ink);
  }
  .back:hover .icon {
    translate: -3px 0;
  }
</style>

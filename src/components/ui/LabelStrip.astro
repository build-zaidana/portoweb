---
/**
 * Label-maker strip: black tape with embossed capitals, each letter a little off the
 * baseline like a real hand-held label maker (the journaling reference).
 * The letters are split for that wobble, so they are hidden from screen readers and
 * the same text is read once from a visually hidden copy.
 * Still by default; straightens a little on hover (user-triggered).
 */
interface Props {
  text: string;
  /** Changes the letter wobble, so two strips never look identical. */
  seed?: number;
  class?: string;
}

const { text, seed = 11, class: className } = Astro.props;

/** Deterministic PRNG (mulberry32): the wobble is the same on every build. */
function rng(state: number) {
  return () => {
    state = (state + 0x6d2b79f5) | 0;
    let t = Math.imul(state ^ (state >>> 15), 1 | state);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const random = rng(seed);
const letters = [...text].map((char) => ({
  char: char === " " ? " " : char,
  y: ((random() - 0.5) * 1.6).toFixed(2),
  r: ((random() - 0.5) * 3).toFixed(1),
}));
---

<span class:list={["strip", className]}>
  <span class="sr-only">{text}</span>
  <span class="letters" aria-hidden="true">
    {letters.map(({ char, y, r }) => (
      <span style={`--y: ${y}px; --r: ${r}deg`}>{char}</span>
    ))}
  </span>
</span>

<style>
  .strip {
    display: inline-flex;
    padding: 0.55rem 1rem 0.5rem;
    border-radius: 3px;
    /* A soft sheen on top and a darker bottom edge read as glossy plastic tape. */
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.12), transparent 45%, rgb(0 0 0 / 0.3)), var(--tape);
    color: var(--on-tape);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    rotate: 4deg;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.08) inset,
      0 6px 12px -4px rgb(0 0 0 / 0.4);
    /* Dark mode: a hairline edge so black tape doesn't sink into the night sky. */
    outline: 1px solid light-dark(transparent, rgb(236 234 228 / 0.16));
    transition: rotate var(--dur-4) var(--ease-spring);
  }
  @media (hover: hover) {
    .strip:hover {
      rotate: 1deg;
    }
  }
  .letters span {
    display: inline-block;
    translate: 0 var(--y);
    rotate: var(--r);
    /* Embossed: dark shadow below, a faint highlight above. */
    text-shadow:
      0 1px 0 rgb(0 0 0 / 0.7),
      0 -0.5px 0 rgb(255 255 255 / 0.4);
  }
</style>

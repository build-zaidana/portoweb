---
/**
 * Round sticker with text running around the edge (daylight reference).
 * Still by default; turns a little on hover (user-triggered). The visible ring
 * text is decorative; the accessible name comes from `label`.
 */
import SketchIcon, { type IconName } from "./SketchIcon.astro";

interface Props {
  /** Text around the ring, repeated to fill the circle. */
  text: string;
  /** Accessible name (read once, instead of the repeated ring text). */
  label: string;
  icon?: IconName;
  class?: string;
}

const { text, label, icon = "spark", class: className } = Astro.props;
const ringText = `${text} · ${text} · `;
const pathId = `sticker-ring-${text.length}`;
---

<span class:list={["sticker", className]} role="img" aria-label={label}>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <defs>
      <path id={pathId} d="M60 60 m-44 0 a44 44 0 1 1 88 0 a44 44 0 1 1 -88 0" />
    </defs>
    <circle cx="60" cy="60" r="58" class="disc" />
    <circle cx="60" cy="60" r="31" class="inner" />
    <text class="ring">
      <textPath href={`#${pathId}`} textLength="276" lengthAdjust="spacing">
        {ringText}
      </textPath>
    </text>
  </svg>
  <span class="center">
    <SketchIcon name={icon} size={26} />
  </span>
</span>

<style>
  .sticker {
    position: relative;
    display: inline-grid;
    place-items: center;
    inline-size: 7.25rem;
    block-size: 7.25rem;
    rotate: -10deg;
    transition: rotate var(--dur-4) var(--ease-spring);
    filter: drop-shadow(0 6px 10px var(--shadow-tint));
  }
  @media (hover: hover) {
    .sticker:hover {
      rotate: 12deg;
    }
  }
  svg {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
  }
  .disc {
    fill: var(--tan);
  }
  .inner {
    fill: none;
    stroke: var(--on-fill);
    stroke-opacity: 0.35;
    stroke-dasharray: 2 3;
  }
  .ring {
    fill: var(--on-fill);
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .center {
    position: relative;
    color: var(--on-fill);
  }
  @media (prefers-reduced-motion: reduce) {
    .sticker:hover {
      rotate: -10deg;
    }
  }
</style>

---
/**
 * Every page renders inside this layout.
 * Head order matters: ThemeScript runs before any paint, fonts preload early.
 */
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import ThemeScript from "../components/ThemeScript.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SketchFilter from "../components/ui/SketchFilter.astro";
import Analytics from "../components/Analytics.astro";
import { site } from "../lib/site";
import { pageTransition } from "../lib/motion";
import "../styles/global.css";

interface Props {
  /** Page title without the site name. Omit on the home page. */
  title?: string;
  description?: string;
  /** Absolute or root-relative OG image. Defaults to the site card (public/og-default.png, 1200×630). */
  image?: string;
  /** Keep utility pages (e.g. /styleguide) out of search results. */
  noindex?: boolean;
  /** Show the closing moment (floating cards + big CTA) above the footer. Home only. */
  closing?: boolean;
  /** Open Graph type: "article" for posts and project write-ups. */
  ogType?: "website" | "article";
}

const {
  title,
  description = site.description,
  image,
  noindex = false,
  closing = false,
  ogType = "website",
} = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? site.ogImage, Astro.site).href;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}: learning to build software that helps people`} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Browser UI color follows the page surface in each mode. -->
    <meta name="theme-color" content="#f3f2ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161915" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} · Writing`} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Only the display serif is above the fold on every page, so only it is preloaded. -->
    <Font cssVariable="--font-instrument-serif" preload />
    <Font cssVariable="--font-general-sans" />
    <Font cssVariable="--font-jetbrains-mono" />
    <Font cssVariable="--font-caveat" />

    <ClientRouter />
    <Analytics />
  </head>
  <body>
    <SketchFilter />
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1" transition:name="page-main" transition:animate={pageTransition}>
      <slot />
    </main>
    <SiteFooter closing={closing} />
  </body>
</html>

<style>
  /* Visually hidden until focused with the keyboard (clip pattern, robust in print and capture tools). */
  .skip-link:not(:focus-visible) {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .skip-link:focus-visible {
    position: fixed;
    inset-block-start: 0.75rem;
    inset-inline-start: 0.75rem;
    z-index: 100;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    background-color: var(--ink);
    color: var(--paper);
    font-weight: 500;
    animation: skip-in var(--dur-2) var(--ease-out);
  }
  @keyframes skip-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }
  main:focus {
    outline: none;
  }
</style>

<script>
  /**
   * Decides how the next page arrives (see src/lib/motion.ts) and writes it onto the
   * incoming <html> before the swap, so the transition's keyframes can read it.
   */
  import { navMotion } from "../lib/motion";

  let clear: number | undefined;
  document.addEventListener("astro:before-swap", (event) => {
    const { x, stagger } = navMotion(event.from, event.to);
    const root = event.newDocument.documentElement;
    root.style.setProperty("--nav-x", String(x));
    if (stagger) root.dataset.navStagger = "";
  });
  // The stagger only belongs to the arrival; remove it so later re-renders don't replay it.
  document.addEventListener("astro:page-load", () => {
    window.clearTimeout(clear);
    clear = window.setTimeout(() => delete document.documentElement.dataset.navStagger, 1000);
  });
</script>
